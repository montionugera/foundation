{
  "autoCompactWindow": 200000,
  "promptCacheTtl": "5m",
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "linear@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 600,
            "command": "grep -q 'git.*push' || exit 0; cargo xtask attribution >&2 || exit 2"
          }
        ]
      }
    ]
  }
}
